{#=====================================================
  task page
  - Shows details of a single task
  - Has a delete link to remove it
=====================================================#}

{% extends 'pages/base.jinja' %}


{% block title %}

    Flask Demo - Single task

{% endblock %}


{% block content %}

    <h1>A Single task...</h1>


    <article>

        <header>
            <h3>{{ task.name }}</h3>
        </header>

       

        <footer>
            <a href="/delete/{{ tasks.id }}" onclick="return confirm('Really delete?');">Delete</a>
        </footer>

    </article>


    <a role="button" href="/tasks">Back to the To Do List</a>

{% endblock %}